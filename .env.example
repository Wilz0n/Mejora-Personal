# ─────────────────────────────────────────────────────────────
# Base de datos PostgreSQL (Vercel Postgres / Neon / Supabase)
# Formato: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/lifetracker?schema=public"

# ─────────────────────────────────────────────────────────────
# NextAuth (sólo necesario si NO usas el Modo Usuario Único)
# Genera el secreto con: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Modo Usuario Único (self-hosted personal)
# Si lo activas, la app omite el login y usa siempre un único usuario
# creado automáticamente. Ideal para uso personal en tu propio Vercel.
#
# Debes definir AMBAS con el mismo valor:
#  - SINGLE_USER_MODE           -> usada por el servidor (lógica de auth)
#  - NEXT_PUBLIC_SINGLE_USER_MODE -> usada por el cliente (oculta login/logout)
# ─────────────────────────────────────────────────────────────
SINGLE_USER_MODE="false"
NEXT_PUBLIC_SINGLE_USER_MODE="false"
# Opcional: email interno del usuario único (por defecto owner@lifetracker.local)
# SINGLE_USER_EMAIL="owner@lifetracker.local"
