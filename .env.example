# ═══════════════════════════════════════════════════════════════════════════════
# LifeTracker · Variables de entorno
# ═══════════════════════════════════════════════════════════════════════════════
# Este archivo muestra TODAS las variables posibles. Solo necesitas configurar
# las de tu modo de uso (A o B). Copia este archivo a .env.local:
#
#   cp .env.example .env.local
#
# O usa el setup guiado que hace todo por ti:
#
#   npm run setup
#
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# 1. BASE DE DATOS (obligatoria siempre)
# ─────────────────────────────────────────────────────────────────────────────
# Conexión a PostgreSQL. Usa la URL "pooled" de Neon (con -pooler en el host).
# Formato: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# Crea tu BD gratis en https://neon.tech → Create Project → Connect → copia la
# connection string. El script de deploy usa automáticamente la variante directa
# (sin -pooler) para crear tablas; tú solo configura la pooled.
#
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"


# ─────────────────────────────────────────────────────────────────────────────
# 2. MODO DE USO — elige UNO de los dos:
# ─────────────────────────────────────────────────────────────────────────────

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  (A) MODO USUARIO ÚNICO — uso personal, sin login (RECOMENDADO)        │
# │                                                                         │
# │  Solo necesitas estas 3 variables. La app entra directo al Dashboard.  │
# │  NO definas NEXTAUTH_SECRET ni NEXTAUTH_URL en este modo.              │
# └─────────────────────────────────────────────────────────────────────────┘
SINGLE_USER_MODE="true"
NEXT_PUBLIC_SINGLE_USER_MODE="true"

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  (B) MODO CON LOGIN — multi-usuario con registro/login                 │
# │                                                                         │
# │  Descomenta estas y cambia SINGLE_USER_MODE a "false".                 │
# │  Genera el secret con: openssl rand -base64 32                         │
# └─────────────────────────────────────────────────────────────────────────┘
# SINGLE_USER_MODE="false"
# NEXT_PUBLIC_SINGLE_USER_MODE="false"
# NEXTAUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"


# ─────────────────────────────────────────────────────────────────────────────
# RESUMEN RÁPIDO
# ─────────────────────────────────────────────────────────────────────────────
#
# ┌──────────────────────────────────┬──────────────────┬─────────────────────┐
# │ Variable                         │ Modo A (personal)│ Modo B (con login)  │
# ├──────────────────────────────────┼──────────────────┼─────────────────────┤
# │ DATABASE_URL                     │ ✅ Obligatoria    │ ✅ Obligatoria       │
# │ SINGLE_USER_MODE                 │ ✅ "true"         │ ✅ "false"           │
# │ NEXT_PUBLIC_SINGLE_USER_MODE     │ ✅ "true"         │ ✅ "false"           │
# │ NEXTAUTH_SECRET                  │ ❌ No definir     │ ✅ Obligatoria       │
# │ NEXTAUTH_URL                     │ ❌ No definir     │ ✅ Obligatoria       │
# └──────────────────────────────────┴──────────────────┴─────────────────────┘
#
# ⚠️  Regla de oro: si usas modo A (usuario único), NO definas NEXTAUTH_SECRET
#     ni NEXTAUTH_URL. Tenerlas "de más" no rompe nada, pero confunde y ensucian
#     la configuración. Si las tienes en Vercel de un setup anterior, puedes
#     quitarlas o dejarlas — la app las ignora en modo usuario único.
#
# ═══════════════════════════════════════════════════════════════════════════════
